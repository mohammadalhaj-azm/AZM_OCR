# Copy to .env and adjust. All values are optional; defaults shown.

# development (default) or production. production refuses to start with an unsafe configuration: memory job
# store, no RESULT_ENCRYPTION_KEY, API keys or WEBHOOK_SECRET shorter than 32 characters or still "change-me",
# a placeholder DATABASE_URL password, OCR_ALLOW_DOWNLOAD=true. The Docker image sets production.
# Generate keys and secrets with:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENVIRONMENT=development

# Logs: text, or json (one JSON object per line with request_id / job_id / client_id; the Docker image uses json)
LOG_FORMAT=text
LOG_LEVEL=INFO

# LLM backend (OpenAI-compatible). Ollama now; vLLM later, e.g. http://gpu-server:8000/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen3-vl:8b-instruct
# Empty = same server as LLM_BASE_URL. With vLLM (one model per server) e.g. http://gpu-server:8001/v1
LLM_VISION_BASE_URL=
LLM_TIMEOUT_S=180
LLM_VISION_TIMEOUT_S=300
LLM_ENABLED=true
# Ollama: disables Qwen3 "thinking". vLLM: {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={"reasoning_effort": "none"}
LLM_MAX_CHARS=5000
VISION_ENABLED=true
VISION_THRESHOLD=0.7
VISION_MAX_SIDE=1024
RULES_WEIGHT=0.4
VISION_WEIGHT=0.6
# Skip LLM + vision for long documents with no ID signal at all (0 disables a criterion)
LLM_SKIP_MIN_PAGES=5
LLM_SKIP_MIN_CHARS=8000
LLM_SKIP_CONFIDENCE=0.9

# Extraction
MAX_UPLOAD_MB=20
MIN_TEXT_CHARS_PER_PAGE=30
OCR_DPI=300
OCR_PREPROCESS=false
# Parallel OCR: engines (~0.4 GB RAM each), cores split between them unless OCR_CPU_THREADS is set
OCR_ENGINES=2
OCR_PARALLEL_REC=true
# OCR_CPU_THREADS=
# OCR device: empty = GPU 0 when the image has the GPU build of PaddlePaddle (docker-compose.gpu.yml), else CPU.
# OCR_DEVICE=cpu

# Detection
ID_PATTERNS_PATH=config/id_patterns.yaml

# Experimental handwriting OCR: POST /v1/handwriting (README, "Handwriting OCR (experimental)"). Off by default.
# transformers = the model runs in this process: uv sync --extra handwriting, then
#   uv run python -m app.cli download-handwriting-model (~7.5 GB). openai = an OpenAI-compatible server that serves
#   the model (e.g. vLLM; serving this model with vLLM is NOT verified yet, see the README)
HANDWRITING_ENABLED=true
HANDWRITING_BACKEND=transformers
HANDWRITING_MODEL=sherif1313/Arabic-English-handwritten-OCR-v3
# HANDWRITING_BASE_URL=http://gpu-server:8002/v1
# HANDWRITING_API_KEY=
HANDWRITING_TIMEOUT_S=600
# Pages at the model at once, across all requests and jobs. More than 1 needs HANDWRITING_BACKEND=openai (vLLM
# batches them on the GPU; docker-compose.vllm.yml, e.g. 8). The in-process model reads one page at a time.
HANDWRITING_MAX_CONCURRENT=1
# auto = cuda if available. dtype auto = bfloat16 on cuda, float32 on cpu (~15 GB RAM for the weights)
HANDWRITING_DEVICE=auto
HANDWRITING_DTYPE=auto
# Largest image the model sees, in pixels (28x28 = one visual token): the main speed lever on CPU
HANDWRITING_MAX_PIXELS=1003520
HANDWRITING_MIN_PIXELS=3136
# openai backend: images are downscaled to this before upload. GPU / vLLM: 2400 (an A4 page at ~200 DPI)
HANDWRITING_MAX_SIDE=1600
HANDWRITING_MAX_NEW_TOKENS=1024
HANDWRITING_REPETITION_PENALTY=1.1
HANDWRITING_MAX_PAGES=5
HANDWRITING_DPI=200
# Pages without ink are skipped instead of sent to the model (it could invent text for them)
HANDWRITING_BLANK_CHECK=true
HANDWRITING_BLANK_INK_RATIO=0.00001
HANDWRITING_SEGMENTER=whole_page
# Load the model at startup instead of on the first request
HANDWRITING_WARMUP=false
# Empty = the prompt the model was fine-tuned with (app/handwriting/backends.py)
# HANDWRITING_PROMPT=

# Extract-and-answer (experimental, POST /v1/extract-and-answer): pages are routed to PaddleOCR or the handwriting
# model, then the text LLM corrects them, lists what to review and answers questions from the document only.
ANSWER_ENABLED=true
ANSWER_MAX_PAGES=20
ANSWER_MAX_QUESTIONS=10
ANSWER_MAX_QUESTION_CHARS=500
# Empty = LLM_TEXT_MODEL
ANSWER_LLM_MODEL=
ANSWER_TIMEOUT_S=300
ANSWER_MAX_TOKENS=4096
# Must fit Ollama's context window (OLLAMA_CONTEXT_LENGTH in docker-compose.yml): longer input is cut SILENTLY
ANSWER_CHUNK_CHARS=3000
ANSWER_CONTEXT_CHARS=20000
# Page images kept for the handwriting model are downscaled to this: not below HANDWRITING_MAX_SIDE
ANSWER_KEEP_MAX_SIDE=2000
# Correction calls of one job sent at once (page chunks): 1 = one after another. vLLM: e.g. 4 (same result, faster)
ANSWER_LLM_CONCURRENCY=1
# Routing thresholds (PaddleOCR confidences 0-1). STARTING VALUES, NOT CALIBRATED: measure them on your own pages
# with eval/run_routing_eval.py.
ROUTING_LOW_LINE_CONF=0.80
ROUTING_PRINTED_MIN_CONF=0.90
ROUTING_PRINTED_MAX_LOW_SHARE=0.15
ROUTING_HANDWRITTEN_MAX_CONF=0.70
ROUTING_MIN_KEPT_SHARE=0.50
# Unclear pages go to LLM_VISION_MODEL (also needs VISION_ENABLED=true)
ROUTING_VISION=true
# Unclear page and no vision verdict: both | handwriting | printed (the page is marked uncertain in every case)
ROUTING_UNCERTAIN_FALLBACK=both
# Printed Arabic scans: paddle | handwriting
ROUTE_PRINTED_ARABIC=paddle

# API. Either API_KEYS (each key is a client with all scopes and the WEBHOOK_* settings below), or a client registry:
# CLIENTS_FILE (see config/clients.example.yaml) with key hashes, scopes, webhook settings and limits per client.
# With CLIENTS_FILE, leave API_KEYS, WEBHOOK_SECRET and WEBHOOK_ALLOWED_HOSTS empty, and set each client's
# webhook secret variable (e.g. WEBHOOK_SECRET_CIVIL_REGISTRY=...).
API_KEYS=change-me-1,change-me-2
# CLIENTS_FILE=config/clients.yaml
# UPLOAD_DIR defaults to %TEMP%\ocr-id-service
RESULT_TTL_S=3600
MAX_QUEUED_JOBS=100
# Jobs at once. CPU: 1. GPU with vLLM (docker-compose.vllm.yml): e.g. 4, with LLM_WORKER_THREADS=4
WORKER_THREADS=1
# >0: OCR and LLM stages on separate threads (worth it when the LLM runs on another machine / GPU)
LLM_WORKER_THREADS=0
OCR_WARMUP=true
# Synchronous text-only endpoint POST /v1/extract
EXTRACT_MAX_PAGES=20
EXTRACT_MAX_CONCURRENT=2
# Retry-After header (seconds) on 503 queue_full / busy
RETRY_AFTER_S=5
# Longest long-poll for GET /v1/jobs/{id}?wait=
MAX_WAIT_S=30
# Prometheus metrics at GET /metrics (no API key: keep it on an internal network)
METRICS_ENABLED=true

# Job store: memory (single process, lost on restart) or postgres (durable, shared by all replicas)
JOB_STORE=memory
# DATABASE_URL=postgresql://ocr:secret@127.0.0.1:5432/ocr
# docker-compose builds DATABASE_URL from this password
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=10
DB_POLL_S=0.5
JOB_STALE_S=120
JOB_MAX_ATTEMPTS=2
# base64 of 32 random bytes; encrypts uploads, results, file names and metadata in PostgreSQL. Generate with:
#   uv run python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep it outside the database backups. Losing it makes stored results unreadable.
RESULT_ENCRYPTION_KEY=
# Audit trail (ocr_audit_events): events older than this are deleted; 0 = keep them forever
AUDIT_RETENTION_DAYS=365

# Webhooks with API_KEYS (disabled unless both are set; with CLIENTS_FILE they are per client).
# Secret: at least 32 characters (see the generator command above). Timeout and retries apply to all clients.
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT_S=10
# Retries: after 2 s, doubling up to WEBHOOK_MAX_BACKOFF_S, until WEBHOOK_RETRY_WINDOW_S after the job finished
WEBHOOK_RETRY_WINDOW_S=86400
WEBHOOK_BACKOFF_S=2
WEBHOOK_MAX_BACKOFF_S=3600
# Most attempts in total; 0 = no limit (only the window)
WEBHOOK_RETRIES=0
# Simultaneous deliveries per process
WEBHOOK_THREADS=4

# Offline mode: set after models are downloaded (see README). These must be in the
# process environment before Paddle is imported; the app handles that from Phase 1 on.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
HF_HUB_OFFLINE=1

# Admin dashboard (/admin). Off while ADMIN_USERS_FILE is empty. Users and roles: config/admins.example.yaml;
# password hashes and the session secret: uv run python scripts/admin_user.py hash | secret
# ADMIN_USERS_FILE=config/admins.yaml
# ADMIN_SESSION_SECRET=change-me
ADMIN_SESSION_HOURS=8
# Monitoring: resource samples (live view / stored for history), log buffer, retention
SAMPLE_INTERVAL_S=2
SAMPLE_PERSIST_S=10
SAMPLE_RETENTION_H=24
LOG_BUFFER_SIZE=5000
LOG_RETENTION_DAYS=30
# Alerts (shown in the dashboard; every replica evaluates them every ALERT_EVAL_S)
ALERT_EVAL_S=15
ALERT_FOR_S=300
ALERT_CPU_PCT=90
ALERT_MEM_PCT=90
ALERT_DISK_PCT=90
ALERT_GPU_MEM_PCT=95
ALERT_QUEUE_AGE_S=600
ALERT_JOB_STUCK_S=1800
ALERT_FAILURE_RATE=0.1
# Dashboard configuration changes reach every replica within this many seconds
CONFIG_POLL_S=5
# Where eval.run_eval writes summary.json (accuracy in AI monitoring)
EVAL_OUT_DIR=eval/out
